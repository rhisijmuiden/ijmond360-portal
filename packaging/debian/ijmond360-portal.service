[Unit]
Description=IJmond 360 Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
Environment=PORTAL_PACKAGED=1
Environment=NODE_ENV=production
EnvironmentFile=-/etc/ijmond360-portal/env
ExecStart=/usr/lib/ijmond360-portal/node --disable-warning=ExperimentalWarning /usr/lib/ijmond360-portal/server.mjs
Restart=always
RestartSec=2
# Hardening (sudo for self-update needs privilege escalation, so NoNewPrivileges stays off).
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ijmond360-portal /etc/ijmond360-portal
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
