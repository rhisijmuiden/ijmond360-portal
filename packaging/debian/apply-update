#!/bin/sh
# Installs an update package for ijmond360-portal. Runs as root via sudo (see /etc/sudoers.d/ijmond360-portal).
# apt runs in a transient systemd unit so it survives the restart of the service that triggered it.
set -eu
FILE="${1:-}"
case "$FILE" in
  /var/lib/ijmond360-portal/updates/ijmond360-portal_*.deb) ;;
  *) echo "refusing to install $FILE" >&2; exit 2 ;;
esac
case "$FILE" in *..*) echo "refusing to install $FILE" >&2; exit 2 ;; esac
[ -f "$FILE" ] || { echo "missing $FILE" >&2; exit 2; }
[ "$(dpkg-deb -f "$FILE" Package)" = "ijmond360-portal" ] || { echo "wrong package" >&2; exit 2; }
exec systemd-run --unit="ijmond360-portal-update-$(date +%s)" --collect --quiet \
  /usr/bin/env DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y --allow-downgrades "$FILE"
